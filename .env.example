# ─────────────────────────────────────────────────────────────────────────────
# Indexcards_OCR — environment configuration
# Copy to `.env` (never commit `.env`). All values below are read by the backend.
# ─────────────────────────────────────────────────────────────────────────────

# ── Storage location ────────────────────────────────────────────────────────
# Root directory for all runtime data (batches, templates, audit log, caches).
# Relative to the backend working dir, or an absolute path. Put this on an
# encrypted volume in production (see docs/DEPLOYMENT.md).
# DATA_DIR=data

# ── OpenRouter (cloud VLM) ──────────────────────────────────────────────────
# Required only if you use the OpenRouter provider.
OPENROUTER_API_KEY=your_api_key_here

# ── GPUStack (institutional OpenAI-compatible VLM API) ──────────────────────
# Optional provider for interactive/smaller API-driven runs. The token stays
# backend-only. Set GPUSTACK_ENABLED=true to expose the provider in the UI.
# GPUSTACK_ENABLED=false
# GPUSTACK_BASE_URL=https://gpustack.test.hs-itz.de/v1
# GPUSTACK_API_KEY=your-gpustack-token
# GPUSTACK_DEFAULT_MODEL=stable-vlm
# GPUSTACK_LABEL=GPUStack
# GPUSTACK_ENDPOINT_HINT=Institutionell · OpenAI-kompatibel
#
# The backend accepts a base with or without /v1 and normalises it to exactly
# one /v1/chat/completions endpoint. See docs/GPUSTACK.md.

# ── Ollama (self-hosted / on-premise VLM) ───────────────────────────────────
# Point the app at YOUR OWN Ollama instance. No code change, no frontend rebuild:
# the frontend reads these (minus the secret parts) at runtime via GET /api/v1/config.
#
# Base URL of your Ollama server (OpenAI-compatible API). HTTP or HTTPS both work.
#   examples:  http://localhost:11434   https://ollama.your-institution.org
# OLLAMA_BASE_URL=http://localhost:11434
#
# Default model pre-selected in the UI when Ollama is chosen.
# OLLAMA_MODEL_NAME=qwen3-vl:235b
#
# Bearer token, if a reverse proxy in front of Ollama requires one (Ollama itself
# ignores it). Stays backend-only — never sent to the browser.
# OLLAMA_API_KEY=your-ollama-token
#
# Offer the Ollama provider in the UI at all (true/false).
# OLLAMA_ENABLED=true
#
# Cosmetic UI strings (safe to show in the browser — NOT the real URL).
# OLLAMA_LABEL=Ollama (self-hosted)
# OLLAMA_ENDPOINT_HINT=Lokal · on-premise
#
# Model filtering (priority: explicit allow-list → vision filter → all models)
#
# Explicit allow-list: only these exact model ids are offered in the UI.
# Comma-separated. Leave empty to use the vision filter below instead.
# OLLAMA_MODEL_ALLOWLIST=qwen3-vl:235b,qwen2.5vl:72b
#
# Vision filter (default ON): when no explicit allow-list is set, only show
# models whose id looks vision-capable — OCR needs a VLM. This hides the
# embedding/coder/text-only models a typical Ollama server has installed,
# without assuming specific model names. Set false to offer every model.
# OLLAMA_VISION_FILTER=true
#
# Substrings (case-insensitive) that mark a model id as vision-capable.
# Extend this if your local VLM uses a naming scheme not covered by default.
# OLLAMA_VISION_KEYWORDS=vl,vision,llava,-ocr,ocr:,minicpm-v,pixtral,granite3.2-vision,gemma3
#
# Per-request timeout (seconds) for one VLM call. Large models (e.g. qwen3-vl:235b)
# can take minutes per card — raise this if the logs show "Timeout. Retrying…".
# Applies to both OpenRouter and Ollama. Default 120.
# VLM_REQUEST_TIMEOUT_SECONDS=300
#
# Upper bound on the tokens ONE VLM call may generate (OpenAI `max_tokens`, which
# Ollama maps to `num_predict`). A CAP, not a reservation: a response that finishes
# earlier costs and takes exactly as long as with a lower value.
# It must cover a reasoning-capable VLM's chain-of-thought, which is generated
# INSIDE this budget. Symptoms of a limit that is too low are card errors reading
# `truncated_model_response` or `empty_model_response` with finish_reason=length —
# the model spent the whole budget thinking and returned no JSON. Default 8192.
# VLM_MAX_OUTPUT_TOKENS=8192
#
# Ask the provider to enforce a JSON object via `response_format` instead of relying
# on the prompt alone. OFF by default: support depends on the provider, a reverse
# proxy in front of Ollama may drop the field, and a constrained decoder can
# interact badly with a model that emits chain-of-thought. The prompt requests JSON
# either way, so a provider that ignores this behaves exactly as before. Verify it
# against your own endpoint on a small run before enabling it for a large one.
# VLM_JSON_MODE=true

# ── Security / hardening (production) ───────────────────────────────────────
# Local single-curator dev needs NONE of these. Set them when deploying behind
# an authenticating reverse proxy. See docs/DEPLOYMENT.md.
#
# Interface the backend binds to. Keep localhost; expose via the proxy only.
# HOST=127.0.0.1
# Optional bearer token guarding the JSON API + WebSocket. Empty = disabled.
# AUTH_TOKEN=change-me-long-random
# Origins accepted for the WebSocket handshake (comma-separated).
# ALLOWED_WS_ORIGINS=https://indexcards.your-institution.org
# Expose /docs + openapi.json (keep false in production).
# ENABLE_DOCS=false
# Restrictive CORS allow-list (leave empty for same-origin behind a proxy).
# CORS_ALLOW_ORIGINS=
# Rate-limit storage — use redis:// when running more than one worker.
# RATE_LIMIT_STORAGE_URI=memory://
# Per-endpoint rate limits (slowapi syntax, e.g. "30/minute").
# RATE_LIMIT_UPLOAD=30/minute
# RATE_LIMIT_START=12/minute
# RATE_LIMIT_RECONCILE=120/minute
# Upload guards (reject oversized / too many / non-image files).
# MAX_UPLOAD_BYTES=26214400            # 25 MB per file
# MAX_UPLOAD_FILES=2000                # per request
# ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.tif,.tiff

# ── Data retention (GDPR storage limitation — audit I-3) ────────────────────
# Encryption at rest is a DEPLOYMENT responsibility (LUKS/BitLocker/FileVault/
# encrypted volume), NOT done by the app. See docs/DEPLOYMENT.md.
#
# Auto-purge completed batches this many days after completion. 0 = OFF (default).
# Only 'completed' batches that are not active/exporting are ever purged.
# RETENTION_DAYS=0
# After a successful METS/MODS ingest export, purge the batch's working data.
# AUTO_PURGE_AFTER_EXPORT=false
# TTL (days) for the per-batch authority reconciliation cache. 0 = no expiry.
# AUTHORITY_CACHE_TTL_DAYS=0

# ── Security audit log (GDPR accountability — audit I-2) ────────────────────
# Append-only JSONL log of security events (start/cancel/delete/export/purge/
# config changes/auth failures). Never contains OCR text, metadata, or secrets.
# AUDIT_ENABLED=true
# AUDIT_LOG_FILE=data/audit.log.jsonl
# Trusted proxy header carrying the SSO user (name is configurable).
# AUDIT_USER_HEADER=X-Forwarded-User
# Proxy IPs/CIDRs whose user header is trusted. Empty = never trust it (actor
# recorded as "unknown"). MUST be set for real per-user accountability.
# TRUSTED_PROXY_IPS=10.0.0.1,192.168.0.0/16

# ── Authority reconciliation (optional) ─────────────────────────────────────
# GEONAMES_USERNAME=your_geonames_username

# ── LLM corrector (optional) ────────────────────────────────────────────────
# Cheap text-only model used to propose fixes for fields that fail validation.
# See docs/LLM_CORRECTION.md.
# CORRECTOR_MODEL_NAME=anthropic/claude-haiku-4
# CORRECTOR_MAX_TOKENS=256
# CORRECTOR_TIMEOUT_SECONDS=30

# ── Frontend build-time (VITE_ prefix — baked into the built bundle) ─────────
# Set this at BUILD time (not runtime) when the backend AUTH_TOKEN is set: the
# built frontend then sends `Authorization: Bearer <token>` and `?token=` on the
# WebSocket. Must match the backend AUTH_TOKEN. See docs/DEPLOYMENT.md.
# VITE_API_TOKEN=change-me-long-random

# ─────────────────────────────────────────────────────────────────────────────
# Bulk / multi-batch processing (opt-in; empty root ⇒ feature unavailable)
#
# Orchestrates the existing batch engine sequentially across many source
# folders and consolidates the results into one provenance-bearing CSV.
# Intended for homogeneous collections with an already-tested extraction
# template — the mandatory per-folder QC stop is skipped. Leave BULK_IMPORT_ROOT
# empty (the default) and the feature is entirely unavailable: the API returns
# 404 and the UI hides the entry point.
# ─────────────────────────────────────────────────────────────────────────────

# Absolute path to a directory whose IMMEDIATE subfolders each hold one card
# collection. Only those subfolders are ever offered in the UI; arbitrary
# filesystem paths are never accepted. Source files are only ever READ — never
# modified, moved or deleted. Empty (default) disables bulk mode entirely.
#   e.g. BULK_IMPORT_ROOT=/srv/scans/amiga-tonbandkartei
BULK_IMPORT_ROOT=

# How source images become batch files: hardlink (default, no extra disk; falls
# back to a copy per file when the source is on another filesystem) or copy.
# A hardlink shares its inode with the archival original, so nothing in the
# pipeline may write to a batch-side image — see docs/DEPLOYMENT.md.
BULK_IMPORT_MODE=hardlink

# Continue with the next folder when a folder finishes with recoverable
# image-level errors. Structural/configuration errors always stop the run.
BULK_CONTINUE_ON_BATCH_ERROR=true

# Guard against a pathological import root.
BULK_MAX_FOLDERS=200

# Rate limit for creating/starting a bulk run.
RATE_LIMIT_BULK_START=6/minute
